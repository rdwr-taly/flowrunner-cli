{
  "capabilities": {
    "can_redeploy": true,
    "can_resume": true,
    "can_stop": true,
    "can_update_while_running": false
  },
  "category": "Traffic Tools",
  "deployment": {
    "sdk_config_template": {
      "config": {
        "Flow Target URL": "{{env.FLOW_TARGET_URL}}",
        "Flow Target DNS Override": "{{env.FLOW_TARGET_DNS_OVERRIDE}}",
        "XFF Header Name": "{{env.XFF_HEADER_NAME}}",
        "Simulated Users": "{{env.SIM_USERS}}",
        "Minimum Step Sleep MS": "{{env.MIN_SLEEP_MS}}",
        "Maximum Step Sleep MS": "{{env.MAX_SLEEP_MS}}",
        "Override Step URL Host": "{{env.OVERRIDE_STEP_URL_HOST}}",
        "Debug": "{{env.DEBUG_MODE}}",
        "Flow Cycle Delay MS": "{{env.FLOW_CYCLE_DELAY_MS}}",
        "Allow Flow Concurrency": "{{env.ALLOW_FLOW_CONCURRENCY}}",
        "Run Once": "{{env.RUN_ONCE}}"
      },
      "flowmaps": "{{flowmap_json_for_env.FLOWMAP_IDS}}"
    },
    "default_env_vars": [
      {
        "label": "Flow Target URL",
        "name": "FLOW_TARGET_URL",
        "required": true,
        "type": "string"
      },
      {
        "label": "Flow Target DNS Override",
        "name": "FLOW_TARGET_DNS_OVERRIDE",
        "type": "string"
      },
      {
        "default_value": "X-Forwarded-For",
        "label": "XFF Header Name",
        "name": "XFF_HEADER_NAME",
        "type": "string"
      },
      {
        "default_value": 10,
        "label": "Simulated Users",
        "name": "SIM_USERS",
        "type": "integer"
      },
      {
        "default_value": 100,
        "label": "Minimum Step Sleep MS",
        "name": "MIN_SLEEP_MS",
        "type": "integer"
      },
      {
        "default_value": 1000,
        "label": "Maximum Step Sleep MS",
        "name": "MAX_SLEEP_MS",
        "type": "integer"
      },
      {
        "label": "Flow Cycle Delay MS",
        "name": "FLOW_CYCLE_DELAY_MS",
        "type": "integer"
      },
      {
        "default_value": true,
        "label": "Override Step URL Host",
        "name": "OVERRIDE_STEP_URL_HOST",
        "type": "boolean"
      },
      {
        "default_value": false,
        "label": "Debug",
        "name": "DEBUG_MODE",
        "type": "boolean"
      },
      {
        "label": "Select FlowMaps",
        "name": "FLOWMAP_IDS",
        "required": true,
        "type": "array",
        "ui_type": "flowmap_multi_select"
      },
      {
        "default_value": true,
        "label": "Allow Flow Concurrency",
        "name": "ALLOW_FLOW_CONCURRENCY",
        "type": "boolean"
      },
      {
        "default_value": false,
        "label": "Run Once",
        "name": "RUN_ONCE",
        "type": "boolean"
      }
    ]
  },
  "deploymentContext": "app",
  "description": "Execute multi-step API flows using ShowRunner SDK. Supports continuous, scheduled, and recurring execution modes.",
  "displayName": "FlowRunner",
  "icon": "fas fa-project-diagram",
  "id": "flowrunner-cli",
  "image_id_ref": "razor29/flowrunner-cli",
  "lifecycleOptions": [
    {
      "description": "Run flows continuously until manually stopped.",
      "isDefault": true,
      "label": "Continuous",
      "lifecycle": "stateful"
    },
    {
      "description": "Run flows continuously during a scheduled time window (start to end time).",
      "label": "Scheduled",
      "lifecycle": "scheduled",
      "scheduling_fields": {
        "end_time_utc": {
          "label": "End Time (UTC)",
          "required": true
        },
        "start_time_utc": {
          "label": "Start Time (UTC)",
          "required": true
        },
        "type": "one_time"
      }
    },
    {
      "description": "Run flow(s) once on a repeating interval. Container exits after each run and restarts on the next interval.",
      "label": "Recurring",
      "lifecycle": "recurrent",
      "overrides": {
        "deployment": {
          "env_var_defaults": {
            "RUN_ONCE": true
          }
        }
      },
      "scheduling_fields": {
        "interval_unit": "minutes",
        "interval_value": 60,
        "max_concurrent_runs": 1,
        "start_time_utc": {
          "required": true
        },
        "type": "interval"
      }
    }
  ],
  "monitoring": {
    "prometheus": {
      "enabled": true,
      "scrape_path": "/metrics",
      "scrape_port_number": 9090
    }
  },
  "subCategory": "API Simulation",
  "taskLifecycle": "stateful",
  "ui": {
    "card_basic_metrics": [
      {
        "label": "CPU",
        "max_value": 100,
        "source_path": "system.cpu_percent",
        "unit": "%"
      },
      {
        "label": "Memory",
        "max_value": 100,
        "source_path": "system.memory_percent",
        "unit": "%"
      }
    ],
    "card_info_fields": [
      {
        "label": "Target URL",
        "source_key": "FLOW_TARGET_URL",
        "source_type": "env_var"
      }
    ],
    "card_primary_metric": {
      "label": "RPS",
      "source_path": "flowrunner_requests_per_second",
      "unit": "rps"
    },
    "card_secondary_metrics": [
      {
        "label": "Active Users",
        "source_path": "flowrunner_active_users",
        "unit": ""
      },
      {
        "label": "Avg Flow Duration",
        "source_path": "flowrunner_avg_flow_duration_milliseconds",
        "unit": "ms"
      }
    ],
    "deployment_form_sections": [
      {
        "fields": [
          "FLOW_TARGET_URL",
          "FLOW_TARGET_DNS_OVERRIDE",
          "XFF_HEADER_NAME",
          "SIM_USERS",
          "MIN_SLEEP_MS",
          "MAX_SLEEP_MS",
          "FLOW_CYCLE_DELAY_MS",
          "OVERRIDE_STEP_URL_HOST",
          "DEBUG_MODE",
          "FLOWMAP_IDS",
          "ALLOW_FLOW_CONCURRENCY"
        ],
        "title": "FlowRunner Settings"
      }
    ]
  },
  "schema_version": 6
}
